# Copy this file to .env and fill in real values before starting the server.
# .env is gitignored — never commit real secrets.

# A PostgreSQL connection string.
#
# Local Postgres (no SSL needed):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securechat
#
# Hosted Postgres — Render, Neon, Supabase, etc. all give you a connection
# string in this format when you create a database. Add ?sslmode=require if
# it isn't already in the string they give you (this is what tells the app
# to encrypt the connection — required by virtually every hosted provider):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securechat

# REQUIRED. Signs and verifies login sessions (JWTs). Must be a long, random
# secret — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Port the server listens on. Hosted platforms (Render, etc.) usually set
# this for you automatically — you don't need to set it yourself there.
PORT=3000

# "development" or "production". In production, auth cookies require HTTPS
# (the Secure cookie flag is enabled automatically).
NODE_ENV=development

# The origin your frontend is served from — used for CORS and Socket.io.
# Same-origin by default since Express serves the frontend itself. Set this
# to your real public URL once deployed (e.g. https://your-app.onrender.com).
CLIENT_ORIGIN=http://localhost:3000
